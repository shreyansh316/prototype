# FreeToken Chat — Environment Variables
# Copy this to .env and fill in your values

# ── FreeToken / OpenAI-compatible backend ─────────────────────────────────────
# URL where FreeToken (or any OpenAI-compatible server) is running.
# If FreeToken is on your host machine and the bridge runs in Docker,
# use host.docker.internal instead of localhost.
FREETOKEN_BASE_URL=http://host.docker.internal:8000

# ── Bridge settings ───────────────────────────────────────────────────────────
BRIDGE_PORT=8080
MAX_RETRIES=3
REQUEST_TIMEOUT=120
MAX_CONTEXT_TOKENS=8192
RESPONSE_RESERVE=1024
DB_PATH=/data/chat.db

# ── Frontend settings ─────────────────────────────────────────────────────────
FRONTEND_PORT=3000
# Must be accessible from the BROWSER (not Docker internal network)
NEXT_PUBLIC_BRIDGE_URL=http://localhost:8080
